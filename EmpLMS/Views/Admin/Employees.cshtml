@model EmpLMS.Models.ViewModels.ManageEmployeesViewModel
@{
    ViewData["Title"] = "Manage Employees";
}

    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-glass sticky-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center" href="/Admin/Dashboard">
                <i class="fa-solid fa-layer-group me-2"></i> ELMS Admin
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#topNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="topNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                            <img src="https://ui-avatars.com/api/?name=@(User.Identity?.Name ?? "Admin")&background=4361ee&color=fff" alt="Profile" class="rounded-circle me-2" width="35" height="35">
                            <span class="fw-600">@(User.Identity?.Name ?? "Admin User")</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end glass-card border-0 mt-2">
                            <li><a class="dropdown-item text-danger" href="/Account/Logout"><i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Logout</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="dashboard-layout">
        <!-- Sidebar -->
        <div class="sidebar d-none d-lg-block">
            <h6 class="text-uppercase text-muted fw-bold mb-3 px-3 text-xs">Menu</h6>
            <a href="/Admin/Dashboard" class="sidebar-link">
                <i class="fa-solid fa-border-all"></i> Dashboard
            </a>
            <a href="/Admin/Employees" class="sidebar-link active">
                <i class="fa-solid fa-users"></i> Employees
            </a>
            <a href="/Admin/Leaves" class="sidebar-link">
                <i class="fa-solid fa-calendar-check"></i> Leave Requests
            </a>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">Manage Employees</h2>
                    <p class="text-muted mb-0">Add, edit, or toggle employee accounts.</p>
                </div>
                <button class="btn btn-custom" data-bs-toggle="modal" data-bs-target="#addEmployeeModal">
                    <i class="fa-solid fa-user-plus me-2"></i> Add New Employee
                </button>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- AJAX Alert Container -->
            <div id="ajaxAlertContainer"></div>

            <!-- Employee Table -->
            <div class="table-responsive glass-card p-3">
                <table class="table table-glass mb-0" id="employeeTable">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Role / Dept</th>
                            <th>Contact</th>
                            <th>Leaves Taken</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Employees.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">No employee records found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var emp in Model.Employees)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(emp.FullName)&background=random" class="rounded-circle me-3" width="45">
                                            <div>
                                                <h6 class="mb-0 fw-600">@emp.FullName</h6>
                                                <small class="text-muted">@emp.EmployeeCode</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="d-block fw-600">@emp.Designation</span>
                                        <small class="text-muted">@emp.DepartmentName</small>
                                    </td>
                                    <td>
                                        <div class="small">@emp.Email</div>
                                        <small class="text-muted">@(string.IsNullOrWhiteSpace(emp.ContactNumber) ? "No phone" : emp.ContactNumber)</small>
                                    </td>
                                    <td>
                                        <span class="fw-bold fs-5">@emp.LeavesTaken</span> / @emp.TotalLeaveQuota
                                    </td>
                                    <td>
                                        <span id="empStatusBadge-@emp.EmployeeId" class="badge @(emp.IsActive ? "badge-approved" : "bg-secondary")">
                                            @(emp.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <a href="/Admin/EditEmployee/@emp.EmployeeId" class="btn btn-sm btn-outline-primary rounded-circle" title="Edit Employee">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                            <form asp-action="ToggleEmployeeStatus" asp-controller="Admin" method="post" class="d-inline toggle-status-form" data-empid="@emp.EmployeeId">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@emp.EmployeeId" />
                                                <button type="submit" id="toggleBtn-@emp.EmployeeId" class="btn btn-sm @(emp.IsActive ? "btn-outline-danger" : "btn-outline-success") rounded-circle" title="@(emp.IsActive ? "Deactivate" : "Activate")">
                                                    <i class="fa-solid @(emp.IsActive ? "fa-ban" : "fa-check")"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                @if (Model.Employees.TotalCount > 0)
                {
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-3 pt-3 border-top">
                        <small class="text-muted mb-2 mb-md-0">
                            Showing <strong>@Model.Employees.StartItem</strong> to <strong>@Model.Employees.EndItem</strong> of <strong>@Model.Employees.TotalCount</strong> employees
                        </small>
                        @if (Model.Employees.TotalPages > 1)
                        {
                            <nav aria-label="Employee pagination">
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item @(!Model.Employees.HasPreviousPage ? "disabled" : "")">
                                        <a class="page-link" href="/Admin/Employees?page=@(Model.Employees.PageIndex - 1)">
                                            <i class="fa-solid fa-chevron-left me-1"></i> Prev
                                        </a>
                                    </li>
                                    @for (int i = 1; i <= Model.Employees.TotalPages; i++)
                                    {
                                        <li class="page-item @(i == Model.Employees.PageIndex ? "active" : "")">
                                            <a class="page-link" href="/Admin/Employees?page=@i">@i</a>
                                        </li>
                                    }
                                    <li class="page-item @(!Model.Employees.HasNextPage ? "disabled" : "")">
                                        <a class="page-link" href="/Admin/Employees?page=@(Model.Employees.PageIndex + 1)">
                                            Next <i class="fa-solid fa-chevron-right ms-1"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        }
                    </div>
                }
            </div>
            
        </div>
    </div>

    <!-- Add Employee Modal -->
    <div class="modal fade" id="addEmployeeModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content glass-card border-0 p-3">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-plus me-2 text-primary-custom"></i> Add New Employee</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="addEmployeeForm" asp-action="AddEmployee" asp-controller="Admin" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div id="addEmployeeAlert" class="d-none"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-600">First Name <span class="text-danger">*</span></label>
                                <input asp-for="NewEmployee.FirstName" class="form-control" required placeholder="John">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-600">Last Name <span class="text-danger">*</span></label>
                                <input asp-for="NewEmployee.LastName" class="form-control" required placeholder="Doe">
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-600">Email Address <span class="text-danger">*</span></label>
                                <input asp-for="NewEmployee.Email" type="email" class="form-control" required placeholder="name@company.com">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-600">Initial Password <span class="text-danger">*</span></label>
                                <input asp-for="NewEmployee.Password" type="password" class="form-control" required value="emp123">
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-600">Department <span class="text-danger">*</span></label>
                                <select asp-for="NewEmployee.DepartmentId" asp-items="Model.DepartmentList" class="form-select" required>
                                    <option value="">-- Select Department --</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-600">Designation / Role <span class="text-danger">*</span></label>
                                <input asp-for="NewEmployee.Designation" class="form-control" required placeholder="e.g. Software Engineer">
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-600">Contact Number</label>
                                <input asp-for="NewEmployee.ContactNumber" class="form-control" placeholder="+1 (555) 000-0000">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-600">Annual Leave Quota <span class="text-danger">*</span></label>
                                <input asp-for="NewEmployee.TotalLeaveQuota" type="number" min="1" max="100" class="form-control" required value="20">
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" id="addEmployeeSubmitBtn" class="btn btn-custom px-4"><i class="fa-solid fa-check me-1"></i> Save Employee</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

@section Scripts {
    <script>
        $(document).ready(() => {
            $(document).on('submit', '.toggle-status-form', (e) => {
                if (!confirm('Are you sure you want to change this employee status?')) {
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}
