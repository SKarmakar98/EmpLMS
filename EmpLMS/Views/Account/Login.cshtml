@model EmpLMS.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    ViewData["BodyClass"] = "login-page";
}

<div class="glass-card login-card text-center">
    <i class="fa-solid fa-users-gear login-icon"></i>
    <h2 class="fw-bold mb-1">Welcome Back</h2>
    <p class="text-muted mb-4">Employee Leave Management System</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger py-2 text-start small mb-3">
            <i class="fa-solid fa-circle-exclamation me-1"></i>
            <div asp-validation-summary="All" class="d-inline"></div>
        </div>
    }

    <form id="loginForm" asp-controller="Account" asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="form-floating mb-3 text-start">
            <input asp-for="Email" type="email" class="form-control" id="floatingInput" placeholder="name@example.com" required autofocus>
            <label for="floatingInput"><i class="fa-regular fa-envelope me-2"></i>Email address</label>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="form-floating mb-4 text-start">
            <input asp-for="Password" type="password" class="form-control" id="floatingPassword" placeholder="Password" required>
            <label for="floatingPassword"><i class="fa-solid fa-lock me-2"></i>Password</label>
        </div>

        <button id="loginBtn" class="btn btn-custom w-100 py-2 fs-5 mt-2" type="submit">Sign In <i class="fa-solid fa-arrow-right ms-2"></i></button>
    </form>
</div>
