@{
    ViewData["Title"] = "Access Denied";
    ViewData["BodyClass"] = "login-page";
}

<div class="glass-card login-card text-center p-4 p-md-5" style="max-width: 480px;">
    <div class="mb-4">
        <i class="fa-solid fa-shield-halved text-danger" style="font-size: 4rem;"></i>
    </div>
    <h2 class="fw-bold mb-2 text-danger">403 - Access Denied</h2>
    <p class="text-muted mb-4">
        You do not have the required permissions or role to access this resource.
    </p>

    <div class="d-flex flex-column gap-2">
        @if (User.IsInRole("Admin"))
        {
            <a href="/Admin/Dashboard" class="btn btn-custom w-100 py-2">
                <i class="fa-solid fa-house me-2"></i> Return to Admin Dashboard
            </a>
        }
        else if (User.IsInRole("Employee"))
        {
            <a href="/Employee/Dashboard" class="btn btn-custom w-100 py-2">
                <i class="fa-solid fa-house me-2"></i> Return to My Dashboard
            </a>
        }
        else
        {
            <a href="/Account/Login" class="btn btn-custom w-100 py-2">
                <i class="fa-solid fa-right-to-bracket me-2"></i> Go to Login
            </a>
        }

        <a href="/Account/Logout" class="btn btn-outline-danger w-100 py-2 mt-1">
            <i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Sign Out
        </a>
    </div>
</div>
