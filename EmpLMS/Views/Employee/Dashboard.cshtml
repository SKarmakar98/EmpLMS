@model EmpLMS.Models.ViewModels.EmployeeDashboardViewModel
@{
    ViewData["Title"] = "Employee Dashboard";
}

    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-glass sticky-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center" href="/Employee/Dashboard">
                <i class="fa-solid fa-layer-group me-2"></i> ELMS 
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#topNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="topNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                            <img src="https://ui-avatars.com/api/?name=@(User.Identity?.Name ?? "Employee")&background=3f37c9&color=fff" alt="Profile" class="rounded-circle me-2" width="35" height="35">
                            <span class="fw-600">@(User.Identity?.Name ?? "Employee User")</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end glass-card border-0 mt-2">
                            <li><a class="dropdown-item text-danger" href="/Account/Logout"><i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Logout</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="dashboard-layout">
        <!-- Sidebar -->
        <div class="sidebar d-none d-lg-block">
            <h6 class="text-uppercase text-muted fw-bold mb-3 px-3 text-xs">Menu</h6>
            <a href="/Employee/Dashboard" class="sidebar-link active">
                <i class="fa-solid fa-border-all"></i> Dashboard
            </a>
            <a href="/Employee/ApplyLeave" class="sidebar-link">
                <i class="fa-solid fa-calendar-plus"></i> Apply Leave
            </a>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">My Dashboard</h2>
                    <p class="text-muted mb-0">Overview of your leave status and history.</p>
                </div>
                <a href="/Employee/ApplyLeave" class="btn btn-custom"><i class="fa-solid fa-paper-plane me-2"></i> Apply for Leave</a>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Stats Row -->
            <div class="row g-4 mb-5">
                <div class="col-md-6 col-lg-3">
                    <div class="glass-card stat-card">
                        <div class="stat-details">
                            <p>Available Leaves</p>
                            <h3>@Model.Summary.AvailableLeaves <span class="text-muted fs-6">/ @Model.Summary.TotalQuota</span></h3>
                        </div>
                        <div class="stat-icon primary">
                            <i class="fa-solid fa-calendar-check"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="glass-card stat-card">
                        <div class="stat-details">
                            <p>Pending Review</p>
                            <h3>@Model.Summary.PendingLeaves <span class="text-muted fs-6">Days</span></h3>
                        </div>
                        <div class="stat-icon warning">
                            <i class="fa-solid fa-clock"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="glass-card stat-card">
                        <div class="stat-details">
                            <p>Used Leaves</p>
                            <h3>@Model.Summary.UsedLeaves <span class="text-muted fs-6">Days</span></h3>
                        </div>
                        <div class="stat-icon success">
                            <i class="fa-solid fa-calendar-xmark"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Leave History Table -->
            <div class="glass-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0">My Leave History</h5>
                    <a href="/Employee/ApplyLeave" class="btn btn-sm btn-outline-custom"><i class="fa-solid fa-plus me-1"></i> New Request</a>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-glass mb-0">
                        <thead>
                            <tr>
                                <th>Date Applied</th>
                                <th>From Date</th>
                                <th>To Date</th>
                                <th>Days</th>
                                <th>Purpose & Remarks</th>
                                <th>Status</th>
                                <th>Admin Note</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.LeaveHistory.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        <i class="fa-regular fa-folder-open d-block fs-3 mb-2 opacity-50"></i>
                                        No leave requests yet. Click <strong>Apply for Leave</strong> to submit your first request!
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.LeaveHistory)
                                {
                                    <tr>
                                        <td>@item.RequestDate.ToString("MMM dd, yyyy")</td>
                                        <td><span class="fw-600">@item.FromDate.ToString("MMM dd, yyyy")</span></td>
                                        <td><span class="fw-600">@item.ToDate.ToString("MMM dd, yyyy")</span></td>
                                        <td><span class="fw-bold">@item.TotalDays</span></td>
                                        <td>
                                            <span class="d-block fw-600 text-primary-custom">@item.LeavePurposeName</span>
                                            <small class="text-muted">@item.Remarks</small>
                                        </td>
                                        <td>
                                            @if (item.Status == "Approved")
                                            {
                                                <span class="badge badge-approved">Approved</span>
                                            }
                                            else if (item.Status == "Rejected")
                                            {
                                                <span class="badge bg-danger">Rejected</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-pending">Pending</span>
                                            }
                                        </td>
                                        <td class="text-muted fst-italic">
                                            @(string.IsNullOrWhiteSpace(item.AdminRemarks) ? "Awaiting review" : item.AdminRemarks)
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.LeaveHistory.TotalCount > 0)
                {
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-3 pt-3 border-top">
                        <small class="text-muted mb-2 mb-md-0">
                            Showing <strong>@Model.LeaveHistory.StartItem</strong> to <strong>@Model.LeaveHistory.EndItem</strong> of <strong>@Model.LeaveHistory.TotalCount</strong> requests
                        </small>
                        @if (Model.LeaveHistory.TotalPages > 1)
                        {
                            <nav aria-label="History pagination">
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item @(!Model.LeaveHistory.HasPreviousPage ? "disabled" : "")">
                                        <a class="page-link" href="/Employee/Dashboard?page=@(Model.LeaveHistory.PageIndex - 1)">
                                            <i class="fa-solid fa-chevron-left me-1"></i> Prev
                                        </a>
                                    </li>
                                    @for (int i = 1; i <= Model.LeaveHistory.TotalPages; i++)
                                    {
                                        <li class="page-item @(i == Model.LeaveHistory.PageIndex ? "active" : "")">
                                            <a class="page-link" href="/Employee/Dashboard?page=@i">@i</a>
                                        </li>
                                    }
                                    <li class="page-item @(!Model.LeaveHistory.HasNextPage ? "disabled" : "")">
                                        <a class="page-link" href="/Employee/Dashboard?page=@(Model.LeaveHistory.PageIndex + 1)">
                                            Next <i class="fa-solid fa-chevron-right ms-1"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        }
                    </div>
                }
            </div>
            
        </div>
    </div>
